+# The zlib revision pulled through Protobuf predates current macOS SDK
+# configuration. Its Apple-specific fallback replaces fdopen before the SDK
+# declares it; an identity definition prevents that replacement.
+build:macos --copt=-Dfdopen=fdopen
+build:macos --host_copt=-Dfdopen=fdopen
+
